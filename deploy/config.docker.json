{
  "agents": {
    "defaults": {
      "workspace": "/app/workspace",
      "model": "deepseek-flash",
      "provider": "deepseek"
    }
  },
  "providers": {
    "deepseek": {
      "apiKey": "${CUSTOMER_SUPPORT_API_KEY}",
      "apiBase": "https://api.deepseek.com"
    }
  },
  "channels": {
    "sendProgress": false,
    "sendToolHints": false,
    "showReasoning": false,
    "feishu": {
      "enabled": true,
      "appId": "${FEISHU_APP_ID}",
      "appSecret": "${FEISHU_APP_SECRET}",
      "allowFrom": [],
      "groupPolicy": "mention",
      "streaming": false
    }
  },
  "tools": {
    "mcpServers": {
      "fulfillment_server": {
        "type": "stdio",
        "command": "python",
        "args": [
          "/app/mcp_servers/fulfillment_server.py"
        ],
        "cwd": "/app",
        "env": {
          "FULFILLMENT_SIM_DB": "/runtime/data/fulfillment-simulation.db"
        },
        "enabledTools": [
          "list_shipping_shops",
          "prepare_shipping_batch",
          "get_shipping_batch"
        ]
      }
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "restartMode": "exit",
    "heartbeat": {
      "enabled": false
    }
  }
}
